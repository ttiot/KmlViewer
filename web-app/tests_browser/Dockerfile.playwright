# Client Playwright pour le banc navigateur : image officielle (navigateurs + dépendances système) ÉPINGLÉE par version ET digest ;
# le paquet Python playwright est installé à la même version que les navigateurs de l'image (1.65.2), une seule fois.
FROM mcr.microsoft.com/playwright/python:v1.65.2-noble@sha256:38dd67fc654b56b3cba611e4c8eb71cd33750e1cd29eea2a5dc00b484817a75f
ENV PIP_ROOT_USER_ACTION=ignore PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip install playwright==1.65.2
