# Client Playwright pour le banc navigateur : image officielle (navigateurs + dépendances système) ÉPINGLÉE par version ET digest
# (mcr.microsoft.com/playwright/python:v1.64.1-noble, publiée le 2026-10-22 : plus de deux semaines, EF-6.17) ; le paquet Python
# playwright est installé à la MÊME version (requirements.txt, avec empreintes, --require-hashes).
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
ENV PIP_ROOT_USER_ACTION=ignore PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 PIP_BREAK_SYSTEM_PACKAGES=1
COPY requirements.txt /tmp/requirements.txt
RUN pip install --require-hashes -r /tmp/requirements.txt
