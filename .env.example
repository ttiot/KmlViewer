# Copier en .env (jamais commité). Ce modèle décrit une mise en production (OIDC derrière un
# reverse proxy TLS). Sans aucune variable, l'appli tourne en mono-utilisateur local SANS
# authentification, joignable uniquement sous le nom localhost : usage sur poste.
#
# En déploiement Ansible, ce fichier est GÉNÉRÉ par un template (secrets dans Ansible Vault) : ne pas
# l'éditer sur le serveur, il serait écrasé. Docker Compose ne le relit qu'à la RECRÉATION du conteneur :
#   docker compose up -d          (ou le module docker_compose_v2, state: present)
# `docker compose restart` et ./restart.sh (outil de dev local) redémarrent le conteneur tel quel, sans le relire.
#
# Valeur effective d'un réglage administrable (liste dans le README) : base > ce fichier > défaut.
# Ce fichier n'est donc que la valeur INITIALE : une valeur saisie dans l'espace d'administration (onglet
# Réglages) PRIME sur lui et n'est pas écrasée par un redéploiement (un WARNING au démarrage nomme chaque
# variable ainsi surchargée ; `flask settings-list` montre la source de chaque valeur ; `flask settings-reset
# <clé>` revient à la valeur de ce fichier). Les variables qui ne sont pas des réglages administrables
# (SECRET_KEY, SECRETS_KEY, AUTH_MODE, OIDC_*, PUBLIC_URL, OUTBOUND_ALLOWED_HOSTS, TRUSTED_HOSTS,
# TRUST_PROXY*, SESSION_*, DATA_DIR, DB_PATH, LOG_LEVEL) ne se règlent qu'ici.
#
# Bornes : une valeur d'un réglage administrable hors de ses bornes (indiquées ci-dessous entre
# crochets, tableau complet dans le README) ou illisible est IGNORÉE : le défaut s'applique, avec un
# WARNING au démarrage. Exemples : INBOX_SCAN_INTERVAL < 5 vaut 30 (et non plus 5),
# DEM_TOTAL_TIMEOUT > 600 vaut 90.

# --- Mode d'authentification ------------------------------------------------
# oidc     : authentification obligatoire par SSO ; le démarrage est refusé si OIDC_ISSUER est vide.
#            À toujours écrire en production : une variable OIDC perdue arrête l'appli au lieu
#            de l'ouvrir à tous. Les comptes à mot de passe (sur invitation, avec second facteur
#            TOTP) s'y ajoutent si SECRETS_KEY et PUBLIC_URL sont renseignées.
# password : comptes à mot de passe + second facteur, sans SSO. S'écrit toujours explicitement
#            (jamais déduit). Démarrage refusé si OIDC_ISSUER est défini, ou si SECRET_KEY
#            (32 caractères au moins), TRUSTED_HOSTS, SECRETS_KEY ou PUBLIC_URL manque, ou si
#            PUBLIC_URL n'est pas couverte par TRUSTED_HOSTS. Le premier admin s'amorce avec
#            `flask user-invite --admin <adresse>` (README, « Amorçage du premier administrateur »).
# local    : mono-utilisateur sans authentification, chaque visiteur est administrateur.
# vide     : oidc si OIDC_ISSUER est renseigné, sinon local. Dans ce dernier cas le démarrage
#            est refusé dès qu'un réglage de production est présent (TRUSTED_HOSTS, TRUST_PROXY,
#            SESSION_COOKIE_SECURE, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET) : pour un mode local
#            joint sous un autre nom que localhost, écrire AUTH_MODE=local.
AUTH_MODE=oidc

# --- Adresse publique -------------------------------------------------------
# Origine de l'appli telle que la voient les utilisateurs : https://hôte[:port], sans chemin ni
# identifiants (http:// seulement pour localhost). Seule source des liens envoyés ou affichés
# (invitations, validation d'adresse) : l'en-tête Host n'est jamais utilisé pour cela.
# Obligatoire en mode password (son hôte doit figurer dans TRUSTED_HOSTS) ; en mode oidc, elle
# active les comptes à mot de passe avec SECRETS_KEY. Quand elle est renseignée, l'en-tête Origin
# des requêtes modifiantes est comparé à elle (schéma, hôte, port) : derrière un proxy TLS, c'est
# l'URL https publique. Une instance joignable sous plusieurs noms ne l'est donc plus sous les noms
# autres que celui-ci (leurs POST reçoivent 403).
PUBLIC_URL=

# --- Sessions ---------------------------------------------------------------
# Obligatoire dès que l'OIDC (ou le mode password) est activé : openssl rand -hex 32
# (32 caractères au minimum)
SECRET_KEY=
# Cookie de session marqué Secure (envoyé en HTTPS uniquement). Vide : activé d'office avec
# l'OIDC et le mode password. 0 : dérogation pour un développement local en HTTP, signalée dans les logs.
SESSION_COOKIE_SECURE=
# Durée de vie d'une session, comptée depuis la connexion (l'activité ne la prolonge pas)
SESSION_LIFETIME_HOURS=12
# Nombre de reverse proxies de confiance devant l'appli (X-Forwarded-For/Proto). 0 (défaut sûr) :
# aucun en-tête X-Forwarded-* n'est cru. Passer à 1 SEULEMENT derrière un reverse proxy qui pose
# X-Forwarded-For et X-Forwarded-Proto et qui efface ceux du client : sans proxy, avec 1, le client
# choisit lui-même son adresse (limiteur par IP contourné, audit falsifiable) et son schéma.
# Indispensable à 1 derrière un proxy TLS pour que l'URL de callback OIDC soit générée en https.
TRUST_PROXY=0
# 1 uniquement si le proxy réécrit l'en-tête Host ET pose lui-même X-Forwarded-Host (sans effet
# avec TRUST_PROXY=0). HAProxy transmet Host tel quel et ne pose pas X-Forwarded-Host : laisser à 0.
TRUST_PROXY_HOST=0
# Noms d'hôte sous lesquels l'appli répond, séparés par des virgules (toute autre valeur
# de l'en-tête Host reçoit un 400 ; seule /api/health y échappe). OBLIGATOIRE avec l'OIDC et en
# mode password : le démarrage est refusé sans lui. En mode local, vide = seuls localhost et
# 127.0.0.1 sont acceptés.
TRUSTED_HOSTS=traces.example.com

# --- Secrets chiffrés (mot de passe SMTP, clé d'API, secrets TOTP) -----------
# Clé(s) Fernet. Obligatoire en mode password ; en mode oidc, absente = comptes à mot de passe,
# invitations et saisie de secrets désactivés (pas de refus de démarrage).
# Générer une clé :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Plusieurs clés séparées par des virgules : la PREMIÈRE chiffre, toutes déchiffrent. C'est ainsi
# qu'on change de clé (rotation, voir docs/exploitation.md). Perdue sans copie, elle rend les
# valeurs chiffrées irrécupérables (`flask secrets-reset`). Variable d'environnement seulement,
# jamais dans la base : en garder une copie HORS du serveur et hors des sauvegardes de la base.
SECRETS_KEY=
# Identifiant de partie de confiance (RP ID) des clés de sécurité WebAuthn. Par défaut : l'hôte de PUBLIC_URL (jamais une
# adresse IP). À figer sur le domaine parent pour qu'un changement de nom d'hôte n'invalide pas les clés enregistrées :
# suffixe de l'hôte, au moins deux libellés, jamais un suffixe public (com, co.uk, github.io…). Une valeur refusée désactive
# WebAuthn. WebAuthn exige un PUBLIC_URL en https (http://localhost seulement en test ou en mode debug).
#WEBAUTHN_RP_ID=

# --- Destinations sortantes -------------------------------------------------
# Liste blanche des seuls endroits vers lesquels l'appli peut envoyer des données ou un secret.
# Une entrée par service, séparées par des virgules, de la forme service=destination :
#   routing=<hôte>:<port>   moteur de routage            (port OBLIGATOIRE)
#   dem=<hôte>:<port>       service d'altitude (DEM_URL) (port OBLIGATOIRE)
#   smtp=<hôte>:<port>      serveur d'envoi d'e-mails    (port OBLIGATOIRE)
#   tiles=<hôte>            hôte de fonds de carte (https, 443 ; pas de port)
# Un hôte autorisé pour un service ne vaut pas pour un autre. Littéral IPv6 entre crochets :
# routing=[fd00::1]:8989. Une entrée invalide (port manquant, IPv6 sans crochets, service inconnu)
# empêche le démarrage. Sans entrée tiles=, les hôtes des 5 fonds de carte embarqués restent
# autorisés ; la PREMIÈRE entrée tiles= remplace toute cette liste, et la CSP img-src avec elle : un
# fond dont l'hôte n'y figure plus ne s'affiche plus. DEM_URL, quand elle est posée dans ce fichier,
# est autorisée d'office pour son seul service (de même ROUTING_BASE_URL pour routing). Vide : aucune destination nouvelle n'est possible
# depuis l'administration.
# Exemple : routing=graphhopper:8989,dem=opentopodata:5000,smtp=relay.example.com:587,tiles=a.tile.openstreetmap.org
OUTBOUND_ALLOWED_HOSTS=

# --- Moteur de routage (constructeur de traces, bêta : à ouvrir dans l'administration, onglet Fonctions bêta) ---
# Service `graphhopper` du compose, profil « routing », aucun port publié. Pour l'activer : COMPOSE_PROFILES=routing
# (ci-dessous) ou docker compose --profile routing up -d. NE PAS le démarrer avant le premier graphe (voir ROUTING_ZONE_BUILD
# plus bas : premier graphe par la tâche de la zone, ou ./routing/update.sh en mode historique). docs/exploitation.md.
# Profils compose actifs pour `docker compose up` (lue par docker compose lui-même, pas par l'appli ; testé). À
# décommenter seulement APRÈS le premier graphe :
#COMPOSE_PROFILES=routing
# URL du moteur côté appli (autorisée d'office pour le service routing quand elle est posée ici) :
#ROUTING_BASE_URL=http://graphhopper:8989
# 1 : autorise l'envoi d'une clé API du moteur (réglage routing.api_key) en CLAIR sur une URL http. Le moteur du compose n'a
# pas besoin de clé : ne pas saisir de routing.api_key et laisser à 0 ; sans cela, une clé configurée pour une destination http
# fait déclarer le moteur indisponible.
#ROUTING_ALLOW_CLEARTEXT_KEY=0

# Mémoire (lue par le compose). Valeurs par défaut DIMENSIONNÉES POUR « dune » (64 Go ; zone par défaut : fichier recadré de
# 1,956 Go, graphe de 662 Mo ; mesures V-Z2). Sur une machine plus petite ou pour une autre zone par défaut : règle de
# dimensionnement de docs/exploitation.md (ROUTING_IMPORT_XMX >= tas utilisé pour ROUTING_MAX_IMPORT_BYTES x 1,5 ; limite du
# conteneur d'import >= tas + 2 Go ; service < 80 % de sa limite après charge).
# Service : tas et limite du conteneur (3,28 Gio de pic après charge à dune)
#ROUTING_XMX=3g
#ROUTING_MEM_LIMIT=5g
# Import du graphe : tas et limite du conteneur (pic mesuré 5,2 Gio avec -Xmx12g ; -Xmx8g couvre un fichier de 2,4 Go)
#ROUTING_IMPORT_XMX=8g
#ROUTING_IMPORT_MEM_LIMIT=10g
# Recadrage et fusion (osmium) : limite du conteneur. 4g est une valeur de départ NON MESURÉE : à confirmer sur ta machine.
#ROUTING_OSMIUM_MEM_LIMIT=4g

# --- Couverture pilotée par la zone (routing-zone-donnees, lot Z2) ---
# 0 (défaut) : mode historique. Les extraits viennent de ROUTING_EXTRACT_URLS, les dalles MNT de DEM_BBOX, la mise à jour
#   mensuelle est ./routing/update.sh planifié par cron (docs/exploitation.md), aucune table d'état, aucun panneau.
# 1 : le polygone `routing.coverage_polygon` pilote tout (extraits Geofabrik résolus dans le catalogue, graphe, dalles MNT,
#   points acceptés). ROUTING_EXTRACT_URLS, DEM_BBOX et ROUTING_MAX_DOWNLOAD_BYTES sont alors IGNORÉES. Exige la minuterie
#   systemd `kml-viewer-routing-update.timer` (routing/systemd/) et python3 (3.9 ou plus) sur l'hôte. Lue par l'application
#   ET par l'hôte : recréer le conteneur kml-viewer après changement.
#ROUTING_ZONE_BUILD=0
# Les variables ci-dessous ne servent qu'avec ROUTING_ZONE_BUILD=1. « application » : lues par le conteneur kml-viewer ;
# « hôte » : lues par routing/update.sh ; « les deux » : mêmes valeurs aux deux endroits (l'hôte fait foi : s'il refuse, la
# tâche échoue avec le code `cap`). Plafonds d'une zone :
# ROUTING_MAX_REGIONS : 1 à 50, régions Geofabrik retenues (les deux)
#ROUTING_MAX_REGIONS=20
# ROUTING_MAX_SOURCE_BYTES : somme des tailles des extraits, en octets, 4 Gio (les deux)
#ROUTING_MAX_SOURCE_BYTES=4294967296
# DEM_MAX_TILES : 1 à 1000, dalles MNT de la zone (les deux)
#DEM_MAX_TILES=60
# ROUTING_MAX_IMPORT_BYTES : taille du fichier recadré envoyé à l'import, en octets (hôte). Lié à la RAM d'import : en relever
# la valeur impose de relever ROUTING_IMPORT_XMX et ROUTING_IMPORT_MEM_LIMIT dans la même proportion.
#ROUTING_MAX_IMPORT_BYTES=2400000000
# ROUTING_MAX_UNCOVERED_PCT : 0 à 50, part de la zone tolérée hors de toute région OSM, mer comprise (application)
#ROUTING_MAX_UNCOVERED_PCT=10
# ROUTING_ZONE_SETTLE_S : 0 à 86400 s, délai de stabilité d'une saisie avant la prise (application)
#ROUTING_ZONE_SETTLE_S=300
# Catalogue Geofabrik : racine du sous-arbre et feuilles exclues (agrégats, outre-mer) (les deux)
#ROUTING_CATALOG_ROOT=europe
#ROUTING_CATALOG_EXCLUDE=alps,britain-and-ireland,dach,great-britain,guadeloupe,martinique,mayotte,reunion
# Hôte seulement :
# ROUTING_CATALOG_URL : index Geofabrik (https, hôte de ROUTING_ALLOWED_HOSTS)
#ROUTING_CATALOG_URL=https://download.geofabrik.de/index-v1.json
# Budget par jour UTC, mensuelle comprise : tâches (1 à 100) et octets téléchargés (12 Gio)
#ROUTING_MAX_BUILDS_PER_DAY=6
#ROUTING_MAX_DOWNLOAD_BYTES_PER_DAY=12884901888
# ROUTING_CACHE_MAX_BYTES : cache des extraits, en octets, 8 Gio (la sélection active n'est jamais purgée)
#ROUTING_CACHE_MAX_BYTES=8589934592
# ROUTING_MONTHLY_DAYS : 1 à 365, jours entre deux mises à jour mensuelles (même tâche, motif « mensuel »)
#ROUTING_MONTHLY_DAYS=30
# ROUTING_STEP_TIMEOUT : 60 à 86400 s, durée maximale de chaque étape (recadrage, fusion, import, dalles)
#ROUTING_STEP_TIMEOUT=7200
# Correction d'altitude : l'étape MNT de la tâche n'a lieu seulement si DEM_URL désigne le service local « opentopodata » (voir plus bas).

# Lues par routing/update.sh, dans les deux modes (lignes CLE=valeur, sans guillemets imbriqués ni commentaire en fin de ligne) :
#ROUTING_ALLOWED_HOSTS=download.geofabrik.de
# ROUTING_KEEP_GRAPHS : 2 à 20, graphe courant compris (2 = retour arrière possible)
#ROUTING_KEEP_GRAPHS=2
# ROUTING_HEALTH_TIMEOUT : 5 à 3600 s, attente de santé du moteur après bascule
#ROUTING_HEALTH_TIMEOUT=300
# ROUTING_LOCK : chemin absolu du fichier de verrou (défaut : .routing-update.lock dans le dossier du projet)
#ROUTING_LOCK=/srv/kmlviewer/.routing-update.lock
# Mode historique seulement (ROUTING_ZONE_BUILD=0) :
#ROUTING_EXTRACT_URLS=https://download.geofabrik.de/europe/france/nord-pas-de-calais-latest.osm.pbf https://download.geofabrik.de/europe/france/picardie-latest.osm.pbf https://download.geofabrik.de/europe/belgium-latest.osm.pbf
#ROUTING_MAX_DOWNLOAD_BYTES=3221225472

# --- Tâches de fond ---------------------------------------------------------
# L'ordonnanceur (dossier surveillé, correction d'altitude, purge du journal d'audit, relecture des
# réglages) démarre toujours dans l'appli servie. 0 le coupe : réplique secondaire ou diagnostic.
SCHEDULER_ENABLED=1

# --- Stockage et mémoire ----------------------------------------------------
# Stockage maximal des fichiers d'origine par utilisateur, en Mo (0 = illimité)  [0 – 102400]
USER_QUOTA_MB=2048
# Limite mémoire du conteneur (lue par docker-compose.yml, pas par l'appli). Défaut : 2g. Le hachage
# des mots de passe prend 64 Mo par opération, deux en parallèle au plus : ne pas descendre sous ce
# qu'il faut pour cela en plus du reste (docs/exploitation.md).
#KMLVIEWER_MEM_LIMIT=2g

# --- OIDC (FusionAuth) ------------------------------------------------------
# URL du tenant ; la découverte se fait sur <issuer>/.well-known/openid-configuration
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Si renseigné, le droit admin suit ce rôle applicatif (claim "roles") à chaque connexion.
# Sinon aucun compte ne devient admin en se connectant : le propriétaire se connecte une
# première fois, puis se désigne avec
#   docker compose exec kml-viewer flask user-admin <son login>
# (la commande active aussi son compte) ; il gère ensuite les autres depuis /admin/users.
OIDC_ADMIN_ROLE=
# 0 (défaut) : un nouveau compte attend l'activation par un admin avant d'accéder à l'appli.
# 1 : tout compte de l'IdP est actif dès sa première connexion.
OIDC_AUTO_ACTIVATE=0

# --- Dossier surveillé ------------------------------------------------------
INBOX_ENABLED=1
# [5 – 3600] s
INBOX_SCAN_INTERVAL=30
# Propriétaire des fichiers déposés à la racine de l'inbox (username ou email)
INBOX_DEFAULT_USER=

# --- Correction d'altitude (optionnel) --------------------------------------
# Avec le profil compose « dem » (docker compose --profile dem up -d), une instance
# OpenTopoData locale est démarrée et alimentée en dalles Copernicus GLO-30 :
#   DEM_URL=http://opentopodata:5000/v1/copernicus30
DEM_URL=
# Emprise des dalles à télécharger, MODE HISTORIQUE seulement (ROUTING_ZONE_BUILD=0) : lat_min,lon_min,lat_max,lon_max
# (~45 Mo par degré carré). Avec ROUTING_ZONE_BUILD=1, elle est IGNORÉE : les dalles suivent la zone (emprise d'extraction), et
# l'étape MNT de la tâche n'a lieu seulement si DEM_URL désigne le service local « opentopodata » (jamais l'API publique).
# Exemples : France métropolitaine 41,-6,52,10 (~9 Go) ; Alpes françaises 44,5,47,8 (~0,7 Go)
# Constructeur de traces, zone par défaut : 48,1,52,7 (24 dalles, ~835 Mo mesurés) ; sans MNT, une trace planifiée
# n'a pas d'altitude (le moteur n'en fournit pas).
DEM_BBOX=
# Points par requête  [1 – 1000]
DEM_BATCH_SIZE=100
# Délai d'une requête MNT, en secondes  [1 – 120]. Défaut : 15.
#DEM_TIMEOUT=15
# Uniquement si DEM_URL pointe l'API publique api.opentopodata.org (1 requête/s, et les
# traces sortent alors de chez toi)  [0 – 10] s
DEM_REQUEST_DELAY=0
# Durée maximale d'une correction d'altitude, en secondes (toutes requêtes comprises)  [10 – 600]
# À relever avec DEM_REQUEST_DELAY=1 : 90 s ne couvrent alors qu'environ 180 km de trace.
DEM_TOTAL_TIMEOUT=90
# Activités dont l'altitude est corrigée par cycle de la tâche de fond  [1 – 1000]
DEM_BACKFILL_BATCH=25
# Intervalle du balayage périodique, en secondes  [30 – 3600]. Défaut : 300. Un import réveille la
# tâche tout de suite : cet intervalle ne sert qu'à rattraper les reliquats.
#DEM_BACKFILL_INTERVAL=300

APP_TIMEZONE=Europe/Paris
LOG_LEVEL=INFO
