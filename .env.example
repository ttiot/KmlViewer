# Copier en .env (jamais commité). Sans OIDC_ISSUER, l'appli tourne en mono-utilisateur
# local SANS authentification : à réserver à un usage sur poste.

# --- Sessions ---------------------------------------------------------------
# Obligatoire dès que l'OIDC est activé : openssl rand -hex 32
SECRET_KEY=
# 1 dès que l'appli est servie en HTTPS (cookie de session marqué Secure)
SESSION_COOKIE_SECURE=1
# Durée de vie d'une session, comptée depuis la connexion (l'activité ne la prolonge pas)
SESSION_LIFETIME_HOURS=12
# Nombre de reverse proxies de confiance devant l'appli (X-Forwarded-For/Proto),
# indispensable pour que l'URL de callback OIDC soit générée en https
TRUST_PROXY=1
# 1 uniquement si le proxy réécrit l'en-tête Host ET pose lui-même X-Forwarded-Host.
# HAProxy transmet Host tel quel et ne pose pas X-Forwarded-Host : laisser à 0.
TRUST_PROXY_HOST=0
# Noms d'hôte sous lesquels l'appli répond, séparés par des virgules (toute autre valeur
# de l'en-tête Host reçoit un 400). Vide : sans OIDC, seuls localhost et 127.0.0.1 sont
# acceptés ; à renseigner si l'appli est jointe sous un autre nom.
TRUSTED_HOSTS=
# Stockage maximal des fichiers d'origine par utilisateur, en Mo (0 = illimité)
USER_QUOTA_MB=2048

# --- OIDC (FusionAuth) ------------------------------------------------------
# URL du tenant ; la découverte se fait sur <issuer>/.well-known/openid-configuration
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Si renseigné, le droit admin suit ce rôle applicatif (claim "roles") à chaque connexion.
# Sinon, le premier compte connecté devient admin et gère les autres depuis l'appli.
OIDC_ADMIN_ROLE=
# 0 : un nouveau compte doit être activé par un admin avant d'accéder à l'appli
OIDC_AUTO_ACTIVATE=1

# --- Dossier surveillé ------------------------------------------------------
INBOX_ENABLED=1
INBOX_SCAN_INTERVAL=30
# Propriétaire des fichiers déposés à la racine de l'inbox (username ou email)
INBOX_DEFAULT_USER=

# --- Correction d'altitude (optionnel) --------------------------------------
# Avec le profil compose « dem » (docker compose --profile dem up -d), une instance
# OpenTopoData locale est démarrée et alimentée en dalles Copernicus GLO-30 :
#   DEM_URL=http://opentopodata:5000/v1/copernicus30
DEM_URL=
# Emprise des dalles à télécharger : lat_min,lon_min,lat_max,lon_max (~45 Mo par degré carré).
# Exemples : France métropolitaine 41,-6,52,10 (~9 Go) ; Alpes françaises 44,5,47,8 (~0,7 Go)
DEM_BBOX=
DEM_BATCH_SIZE=100
# Uniquement si DEM_URL pointe l'API publique api.opentopodata.org (1 requête/s, et les
# traces sortent alors de chez toi)
DEM_REQUEST_DELAY=0
# Activités dont l'altitude est corrigée par cycle de la tâche de fond
DEM_BACKFILL_BATCH=25

APP_TIMEZONE=Europe/Paris
LOG_LEVEL=INFO
